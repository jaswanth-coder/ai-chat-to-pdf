{
  "manifest_version": 3,
  "name": "AI Chat to PDF - ChatGPT, Claude & Gemini",
  "version": "1.2.0",
  "description": "Download ChatGPT, Claude, and Gemini chats into clean, formatted PDFs with left sidebar prompt index, auto-scan, and smart selection.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "AI Chat to PDF Settings",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "css": [
        "src/styles.css"
      ],
      "js": [
        "src/utils/domHelpers.js",
        "src/adapters/baseAdapter.js",
        "src/adapters/chatgptAdapter.js",
        "src/adapters/claudeAdapter.js",
        "src/adapters/geminiAdapter.js",
        "src/adapters/adapterManager.js",
        "src/exporter/katexCss.js",
        "src/exporter/pdfRenderer.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
